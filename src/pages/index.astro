---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<p class="eyebrow">Blog</p>
	<h1>AOSSI Blog</h1>
	<p class="meta">{SITE_DESCRIPTION} Subscribe with <a href="/rss.xml">RSS</a>.</p>
	<ul class="post-list">
		{posts.map((post) => (
			<li class="h-entry">
				<h2><a class="u-url p-name" href={`/${post.id}/`}>{post.data.title}</a></h2>
				<p><FormattedDate date={post.data.pubDate} /> · {post.data.author}</p>
				<p class="p-summary">{post.data.description}</p>
			</li>
		))}
	</ul>
</Base>
