---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const props = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<Head {...props} />
		<slot name="head" />
	</head>
	<body>
		<Header />
		<main id="main">
			<div class="wrap">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
